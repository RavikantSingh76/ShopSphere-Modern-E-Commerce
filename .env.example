# ===================================================================
# ShopSphere E-Commerce — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to Git.
# ===================================================================

# -------------------------------------------------------------------
# Server & Runtime Configuration
# -------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
FRONTEND_PORT=80

# -------------------------------------------------------------------
# MySQL 8.x Database Configuration (Docker & Standalone)
# -------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=change_this_to_a_secure_database_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password

# -------------------------------------------------------------------
# JWT Security Configuration (Requires a strong 256-bit secret key)
# -------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated)
# In Docker, Nginx handles reverse proxying so requests are same-origin.
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173

# -------------------------------------------------------------------
# Razorpay Payment Gateway (Optional: Leave empty for simulated DEMO payment)
# -------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=ShopSphere

# -------------------------------------------------------------------
# Redis 7 Caching Configuration
# -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password

# -------------------------------------------------------------------
# Media Storage Configuration (local or s3)
# -------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_URL=

# -------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# -------------------------------------------------------------------
# In Docker production with Nginx, leave VITE_API_BASE_URL as /api
VITE_API_BASE_URL=/api
VITE_RAZORPAY_KEY_ID=

# -------------------------------------------------------------------
# Demo / Seed Accounts Configuration (Development & Local Test)
# Leave passwords empty in production to prevent auto-seeding.
# -------------------------------------------------------------------
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_VENDOR_EMAIL=
DEMO_VENDOR_PASSWORD=
